<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.canvas.Canvas?>

<AnchorPane fx:id="root"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.labs.HelloController"
            prefWidth="1320" prefHeight="820"
            style="-fx-background-color: #ffffff;">


    <Canvas fx:id="gameCanvas"
            width="1280"
            height="720"
            style="-fx-border-color: black;"
            AnchorPane.topAnchor="50"
            AnchorPane.leftAnchor="20"
            AnchorPane.bottomAnchor="50"
    />


    <Label fx:id="timerLabel"
           text="Время: 0.0 сек"
           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #f0f0f0;"
           AnchorPane.topAnchor="20"
           AnchorPane.rightAnchor="20"/>

    <HBox spacing="20" alignment="CENTER" AnchorPane.topAnchor="60" AnchorPane.rightAnchor="20">
        <Label fx:id="boyCountLabel" text="Мальчики: 0" style="-fx-background-color: #e6f3ff; -fx-padding: 5 10;"/>
        <Label fx:id="girlCountLabel" text="Девочки: 0" style="-fx-background-color: #ffe6f3; -fx-padding: 5 10;"/>
        <Label fx:id="totalCountLabel" text="Всего: 0" style="-fx-background-color: #f0f0f0; -fx-padding: 5 10;"/>
        <Label fx:id="totalSimulationTime" text="Время: 0.0 сек" style="-fx-background-color: #f0f0f0; -fx-padding: 5 10;"/>
    </HBox>


    <HBox spacing="20" alignment="CENTER"
          AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="20"
          AnchorPane.rightAnchor="20">
        <Button fx:id="startButton"
                text="Start"
                onAction="#handleStartButton"
                prefWidth="300"
                style="-fx-background-color: #05f106; -fx-text-fill: #FFFFFF;"/>
        <Button fx:id="stopButton"
                text="Stop"
                onAction="#handleStopButton"
                prefWidth="300"
                style="-fx-background-color: #ff0000; -fx-text-fill: #FFFFFF;"/>
        <Button fx:id="showTimerButton"
                text="Show timer"
                onAction="#handleShowTimerButton"
                prefWidth="300"
                style="-fx-background-color: #000000; -fx-text-fill: #FFFFFF;"/>
    </HBox>
</AnchorPane>